// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  TRAINER
  ADMIN
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  AI_GENERATED
  NEEDS_REVIEW
  APPROVED
  REJECTED
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LearningPathStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  RECOMMENDED
  UPCOMING
}

enum MaterialStatus {
  PROCESSING
  READY
  FAILED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(EMPLOYEE)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile              Profile?
  assessmentAttempts   AssessmentAttempt[]
  quizAttempts         QuizAttempt[]
  uploadedMaterials    Material[]
  notifications        Notification[]
  generatedQuestions   GeneratedQuestion[]

  @@map("users")
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())

  profiles Profile[]

  @@map("departments")
}

model JobRole {
  id           String   @id @default(uuid())
  title        String
  code         String   @unique
  department   String?
  level        String?
  description  String?
  createdAt    DateTime @default(now())

  profiles Profile[]

  @@map("job_roles")
}

model Profile {
  id              String   @id @default(uuid())
  userId          String   @unique
  firstName       String
  lastName        String
  employeeId      String?  @unique
  designation     String?
  departmentId    String?
  jobRoleId       String?
  experience      Float    @default(0)
  education       String?
  phone           String?
  avatar          String?
  bio             String?
  joinedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  department      Department?  @relation(fields: [departmentId], references: [id])
  jobRole         JobRole?     @relation(fields: [jobRoleId], references: [id])
  competencies    EmployeeCompetency[]
  skillGaps       SkillGap[]
  learningPaths   LearningPath[]
  recommendations Recommendation[]
  learningHistory LearningHistory[]
  certificates    Certificate[]

  @@map("profiles")
}

model Competency {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  category    String
  description String?
  maxLevel    Float    @default(5.0)
  createdAt   DateTime @default(now())

  employeeCompetencies EmployeeCompetency[]
  skillGaps            SkillGap[]
  questions            Question[]
  generatedQuestions   GeneratedQuestion[]
  learningPathItems    LearningPathItem[]
  quizCompetencies     QuizCompetency[]

  @@map("competencies")
}

model EmployeeCompetency {
  id              String   @id @default(uuid())
  profileId       String
  competencyId    String
  currentLevel    Float    @default(0)
  requiredLevel   Float    @default(3.0)
  lastAssessed    DateTime?
  evidence        String?
  updatedAt       DateTime @updatedAt

  profile    Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  competency Competency @relation(fields: [competencyId], references: [id])

  @@unique([profileId, competencyId])
  @@map("employee_competencies")
}

model SkillGap {
  id            String   @id @default(uuid())
  profileId     String
  competencyId  String
  gapScore      Float
  priority      Int      @default(3)
  reason        String?
  identifiedAt  DateTime @default(now())
  resolvedAt    DateTime?

  profile    Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  competency Competency @relation(fields: [competencyId], references: [id])

  @@unique([profileId, competencyId])
  @@map("skill_gaps")
}

model Assessment {
  id          String   @id @default(uuid())
  title       String
  description String?
  duration    Int      @default(30)
  totalMarks  Int      @default(100)
  passingScore Int     @default(60)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  questions AssessmentQuestion[]
  attempts  AssessmentAttempt[]

  @@map("assessments")
}

model Question {
  id           String             @id @default(uuid())
  text         String
  optionA      String
  optionB      String
  optionC      String
  optionD      String
  correctAnswer String
  explanation  String?
  difficulty   QuestionDifficulty @default(MEDIUM)
  competencyId String?
  domain       String?
  createdAt    DateTime           @default(now())

  competency           Competency?           @relation(fields: [competencyId], references: [id])
  assessmentQuestions  AssessmentQuestion[]

  @@map("questions")
}

model AssessmentQuestion {
  id           String @id @default(uuid())
  assessmentId String
  questionId   String
  order        Int

  assessment Assessment @relation(fields: [assessmentId], references: [id])
  question   Question   @relation(fields: [questionId], references: [id])

  @@unique([assessmentId, questionId])
  @@map("assessment_questions")
}

model AssessmentAttempt {
  id             String   @id @default(uuid())
  userId         String
  assessmentId   String
  answers        Json
  score          Float?
  percentage     Float?
  passed         Boolean?
  startedAt      DateTime @default(now())
  completedAt    DateTime?
  analysisResult Json?

  user       User       @relation(fields: [userId], references: [id])
  assessment Assessment @relation(fields: [assessmentId], references: [id])

  @@map("assessment_attempts")
}

model Course {
  id              String   @id @default(uuid())
  title           String
  provider        String
  description     String?
  duration        String?
  level           SkillLevel @default(BEGINNER)
  skills          String[]
  url             String?
  imageUrl        String?
  isIgot          Boolean  @default(false)
  category        String?
  createdAt       DateTime @default(now())

  recommendations Recommendation[]
  learningPathItems LearningPathItem[]
  learningHistory  LearningHistory[]

  @@map("courses")
}

model NsstaProgramme {
  id              String   @id @default(uuid())
  title           String
  description     String?
  targetAudience  String?
  duration        String?
  mode            String?
  competencies    String[]
  eligibility     String?
  schedule        String?
  venue           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  recommendations Recommendation[]

  @@map("nssta_programmes")
}

model LearningPath {
  id          String   @id @default(uuid())
  profileId   String
  title       String
  goal        String?
  description String?
  isActive    Boolean  @default(true)
  progress    Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  items   LearningPathItem[]

  @@map("learning_paths")
}

model LearningPathItem {
  id             String             @id @default(uuid())
  learningPathId String
  courseId       String?
  competencyId   String?
  title          String
  description    String?
  status         LearningPathStatus @default(RECOMMENDED)
  order          Int
  duration       String?
  difficulty     QuestionDifficulty @default(MEDIUM)
  skills         String[]
  completedAt    DateTime?

  learningPath LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  course       Course?      @relation(fields: [courseId], references: [id])
  competency   Competency?  @relation(fields: [competencyId], references: [id])

  @@map("learning_path_items")
}

model Recommendation {
  id              String   @id @default(uuid())
  profileId       String
  courseId        String?
  nsstaProgrammeId String?
  type            String
  matchPercentage Float?
  reason          String?
  priority        Int      @default(3)
  isViewed        Boolean  @default(false)
  createdAt       DateTime @default(now())

  profile       Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  course        Course?         @relation(fields: [courseId], references: [id])
  nsstaProgramme NsstaProgramme? @relation(fields: [nsstaProgrammeId], references: [id])

  @@map("recommendations")
}

model Material {
  id           String         @id @default(uuid())
  uploadedById String
  title        String
  filename     String
  fileType     String
  fileSize     Int
  filePath     String
  status       MaterialStatus @default(PROCESSING)
  topics       String[]
  summary      String?
  processedAt  DateTime?
  createdAt    DateTime       @default(now())

  uploadedBy         User               @relation(fields: [uploadedById], references: [id])
  generatedQuestions GeneratedQuestion[]

  @@map("materials")
}

model GeneratedQuestion {
  id              String             @id @default(uuid())
  materialId      String?
  uploadedById    String
  text            String
  optionA         String
  optionB         String
  optionC         String
  optionD         String
  correctAnswer   String
  explanation     String?
  difficulty      QuestionDifficulty @default(MEDIUM)
  competencyId    String?
  domain          String?
  status          QuestionStatus     @default(AI_GENERATED)
  aiConfidence    Float?
  reviewNotes     String?
  reviewedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  material     Material?   @relation(fields: [materialId], references: [id])
  uploadedBy   User        @relation(fields: [uploadedById], references: [id])
  competency   Competency? @relation(fields: [competencyId], references: [id])
  quizQuestions QuizQuestion[]

  @@map("generated_questions")
}

model Quiz {
  id           String     @id @default(uuid())
  title        String
  description  String?
  createdById  String
  duration     Int        @default(15)
  passingScore Int        @default(60)
  status       QuizStatus @default(DRAFT)
  totalMarks   Int        @default(100)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  questions    QuizQuestion[]
  attempts     QuizAttempt[]
  competencies QuizCompetency[]

  @@map("quizzes")
}

model QuizCompetency {
  id           String @id @default(uuid())
  quizId       String
  competencyId String

  quiz       Quiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)
  competency Competency @relation(fields: [competencyId], references: [id])

  @@unique([quizId, competencyId])
  @@map("quiz_competencies")
}

model QuizQuestion {
  id                  String @id @default(uuid())
  quizId              String
  generatedQuestionId String
  order               Int

  quiz              Quiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)
  generatedQuestion GeneratedQuestion @relation(fields: [generatedQuestionId], references: [id])

  @@unique([quizId, generatedQuestionId])
  @@map("quiz_questions")
}

model QuizAttempt {
  id          String   @id @default(uuid())
  userId      String
  quizId      String
  answers     Json
  score       Float?
  percentage  Float?
  passed      Boolean?
  startedAt   DateTime @default(now())
  completedAt DateTime?
  feedback    Json?

  user User @relation(fields: [userId], references: [id])
  quiz Quiz @relation(fields: [quizId], references: [id])

  @@map("quiz_attempts")
}

model LearningHistory {
  id          String   @id @default(uuid())
  profileId   String
  courseId    String?
  activityType String
  title       String
  duration    Int?
  completedAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  course  Course? @relation(fields: [courseId], references: [id])

  @@map("learning_history")
}

model Certificate {
  id          String   @id @default(uuid())
  profileId   String
  title       String
  issuer      String
  issuedAt    DateTime
  expiresAt   DateTime?
  credentialId String?
  skills      String[]

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("certificates")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  resource  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}
